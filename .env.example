# Telegram bot configuration (optional — enable this channel to get Telegram alerts)
TELEGRAM_BOT_TOKEN=123456789:AAExampleDummyTokenForDocumentationOnly
TELEGRAM_CHAT_ID=123456789

# Discord webhook configuration (optional — enable this channel to get Discord alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/0000000000000000000/ExampleDummyWebhookTokenForDocsOnly

# cronwrap can be driven entirely by these env vars; every value also has a
# matching CLI flag (--telegram-bot-token, --telegram-chat-id, --discord-webhook-url).
# Flags win when both are set. All values above are DUMMY placeholders — never
# commit real tokens. Copy this file to `.env` and fill in real values locally.
